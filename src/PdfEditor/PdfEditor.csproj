<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version gives access to the built-in Windows.Data.Pdf renderer. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PdfEditor</AssemblyName>
    <RootNamespace>PdfEditor</RootNamespace>
    <Product>PDF Editor</Product>
    <Version>1.2.1</Version>
    <!-- Exe icon (Explorer, Start menu, taskbar). Generated by tools/IconGenerator. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource for the window's title bar and Alt+Tab icon. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEditor.Tests" />
  </ItemGroup>

</Project>
