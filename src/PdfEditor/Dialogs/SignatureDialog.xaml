<Window x:Class="PdfEditor.Dialogs.SignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a signature" Width="640" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource ChromeBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#444">
            Pick a saved signature or initials, or add a new one. After choosing, click on the page where it should go –
            you can then drag, resize and rotate it.
        </TextBlock>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="✎  Draw new…" Click="Draw_Click" Padding="12,5" />
            <Button Content="🖼  Import image…" Click="Import_Click" Padding="12,5" Margin="8,0,0,0" />
            <CheckBox x:Name="RemoveBackground" Content="Make white background transparent" IsChecked="True"
                      VerticalAlignment="Center" Margin="14,0,0,0"
                      ToolTip="Recommended for scanned or photographed signatures on paper" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Style="{StaticResource DialogButton}" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
            <Button DockPanel.Dock="Right" x:Name="UseButton" Content="Use signature" IsDefault="True" Click="Use_Click" Style="{StaticResource DialogButton}" />
        </DockPanel>

        <Grid>
            <ListBox x:Name="List" SelectionMode="Single" MouseDoubleClick="List_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White"
                     BorderBrush="{StaticResource BorderBrush}" SelectionChanged="List_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Height="96" Margin="4" Padding="8" Background="White"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" Text="No saved signatures yet – draw one or import an image."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
