<Window x:Class="PdfEditor.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PDF Editor" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource ChromeBrush}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Margin" Value="0,2,16,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: icon, name, version -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
            <DockPanel>
                <Image x:Name="AppIcon" Width="64" Height="64" Margin="0,0,18,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PDF Editor" FontSize="24" FontWeight="SemiBold" Foreground="#1F2328" />
                    <TextBlock x:Name="VersionText" FontSize="13" Foreground="#4B5563" Margin="0,2,0,0" />
                    <TextBlock Text="Fill in PDF forms, add text and sign them." Foreground="#6B7280" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="CopyrightText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#6B7280" />
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Style="{StaticResource DialogButton}" />
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy details" Click="Copy_Click" Style="{StaticResource DialogButton}"
                        ToolTip="Copy the version and system details, for example to include in a problem report" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,16,24,18">
            <!-- Update status -->
            <Border x:Name="UpdateCard" CornerRadius="6" Padding="14,10" BorderThickness="1">
                <DockPanel>
                    <Button x:Name="UpdateAction" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,4" Margin="12,0,0,0" Click="UpdateAction_Click" />
                    <TextBlock x:Name="UpdateIcon" DockPanel.Dock="Left" FontSize="16" VerticalAlignment="Top" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Foreground="#1F2328" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateDetail" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- System details -->
            <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Windows" Style="{StaticResource Label}" />
                <TextBlock x:Name="WindowsText" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Text=".NET" Grid.Row="1" Style="{StaticResource Label}" />
                <TextBlock x:Name="DotNetText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" />
                <TextBlock Text="Location" Grid.Row="2" Style="{StaticResource Label}" />
                <TextBlock x:Name="LocationText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>

            <!-- Components -->
            <TextBlock Text="Built with" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="PdfSharpText" Style="{StaticResource Value}" />
            <TextBlock x:Name="VelopackText" Style="{StaticResource Value}" />
            <TextBlock Text="Windows PDF renderer (Windows.Data.Pdf) for displaying and printing pages" Style="{StaticResource Value}" />

            <!-- Links -->
            <TextBlock Margin="0,16,0,0">
                <Hyperlink x:Name="NotesLink" RequestNavigate="Link_RequestNavigate">What's new</Hyperlink>
                <Run Text="   ·   " Foreground="#9CA3AF" />
                <Hyperlink x:Name="IssuesLink" RequestNavigate="Link_RequestNavigate">Report a problem</Hyperlink>
                <Run Text="   ·   " Foreground="#9CA3AF" />
                <Hyperlink x:Name="SourceLink" RequestNavigate="Link_RequestNavigate">Source code on GitHub</Hyperlink>
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
