<Window x:Class="PdfEditor.Dialogs.DrawSignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw your signature" Width="720" Height="400" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource ChromeBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Foreground="#444"
                   Text="Sign with your mouse, pen or finger. It will be saved for reuse." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ink:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <RadioButton x:Name="InkBlack" Content="Black" IsChecked="True" VerticalAlignment="Center" Checked="Ink_Changed" />
            <RadioButton x:Name="InkBlue" Content="Blue" Margin="10,0,0,0" VerticalAlignment="Center" Checked="Ink_Changed" />
            <TextBlock Text="Thickness:" VerticalAlignment="Center" Margin="22,0,6,0" />
            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="8" Value="3" Width="140" VerticalAlignment="Center"
                    ValueChanged="Thickness_Changed" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Clear" Click="Clear_Click" Style="{StaticResource DialogButton}" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Click="Save_Click" Style="{StaticResource DialogButton}" />
        </DockPanel>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Line X1="0" X2="1" Y1="0" Y2="0" Stretch="Fill" Stroke="#C8CCD2" StrokeDashArray="4 3"
                      VerticalAlignment="Bottom" Margin="30,0,30,48" IsHitTestVisible="False" />
                <TextBlock Text="✕" Foreground="#B0B5BD" FontSize="18" VerticalAlignment="Bottom" Margin="12,0,0,50" IsHitTestVisible="False" />
                <InkCanvas x:Name="Ink" Background="Transparent" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
