<Window x:Class="PdfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Editor" Width="1280" Height="900" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource ChromeBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <MenuItem x:Name="SaveMenu" Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem x:Name="SaveAsMenu" Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <MenuItem x:Name="SaveFlatMenu" Header="Save _Flattened Copy…" Click="SaveFlat_Click"
                          ToolTip="Saves a copy where form fields become ordinary page content and can no longer be edited" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="Rotate selection left 90°" InputGestureText="Ctrl+Shift+R" Click="RotateLeft_Click" />
                <MenuItem Header="Rotate selection right 90°" InputGestureText="Ctrl+R" Click="RotateRight_Click" />
                <MenuItem Header="Copy selection to all pages" Click="CopyToAll_Click" />
                <MenuItem Header="_Delete selection" InputGestureText="Del" Click="Delete_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _out" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <MenuItem Header="Fit _width" InputGestureText="Ctrl+0" Click="FitWidth_Click" />
                <MenuItem Header="_Actual size" InputGestureText="Ctrl+1" Click="ActualSize_Click" />
                <Separator />
                <MenuItem x:Name="HighlightMenu" Header="_Highlight form fields" IsCheckable="True" IsChecked="True" Click="Highlight_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_How to use" Click="Help_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" IsLocked="True">
            <ToolBar Background="{StaticResource ChromeBrush}">
                <Button Style="{StaticResource ToolButton}" Click="Open_Click" ToolTip="Open a PDF (Ctrl+O)">📂 Open</Button>
                <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Click="Save_Click" ToolTip="Save (Ctrl+S)">💾 Save</Button>
                <Separator />
                <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">↶</Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">↷</Button>
            </ToolBar>

            <ToolBar x:Name="ToolsBar" Background="{StaticResource ChromeBrush}">
                <RadioButton x:Name="SelectTool" Style="{StaticResource ToolRadio}" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="Select, fill in form fields, move and edit placed items (Esc)">🖱 Select</RadioButton>
                <RadioButton x:Name="TextTool" Style="{StaticResource ToolRadio}" Checked="Tool_Checked"
                             ToolTip="Click on the page to type text anywhere">T  Text</RadioButton>
                <RadioButton x:Name="DateTool" Style="{StaticResource ToolRadio}" Checked="Tool_Checked"
                             ToolTip="Click to insert today's date">📅 Date</RadioButton>
                <RadioButton x:Name="CheckTool" Style="{StaticResource ToolRadio}" Checked="Tool_Checked"
                             ToolTip="Click to place a check mark">✓</RadioButton>
                <RadioButton x:Name="CrossTool" Style="{StaticResource ToolRadio}" Checked="Tool_Checked"
                             ToolTip="Click to place a cross">✗</RadioButton>
                <RadioButton x:Name="WhiteoutTool" Style="{StaticResource ToolRadio}" Checked="Tool_Checked"
                             ToolTip="Drag on the page to cover existing content with a white box (visual only – not redaction; the text underneath stays in the file)">▭ White-out</RadioButton>
                <Separator />
                <Button Style="{StaticResource ToolButton}" Click="Signature_Click" FontWeight="SemiBold"
                        ToolTip="Add your signature or initials (draw, or import a scanned image)">✍ Sign</Button>
                <Button Style="{StaticResource ToolButton}" Click="Image_Click"
                        ToolTip="Place any image (logo, stamp, photo)">🖼 Image</Button>
            </ToolBar>



            <ToolBar x:Name="SelectionBar" Band="1" Background="{StaticResource ChromeBrush}" IsEnabled="False">
                <TextBlock x:Name="SelectionLabel" Text="Selected item:" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="#555" />
                <Button Style="{StaticResource ToolButton}" Click="RotateLeft_Click" ToolTip="Rotate left 90° (Ctrl+Shift+R)">⟲ 90°</Button>
                <Button Style="{StaticResource ToolButton}" Click="RotateRight_Click" ToolTip="Rotate right 90° (Ctrl+R)">⟳ 90°</Button>
                <TextBlock Text="Angle" VerticalAlignment="Center" Margin="6,0,4,0" />
                <TextBox x:Name="AngleBox" Width="44" VerticalContentAlignment="Center" KeyDown="AngleBox_KeyDown" LostFocus="AngleBox_LostFocus"
                         ToolTip="Rotation in degrees (clockwise). Press Enter to apply." />
                <TextBlock Text="°" VerticalAlignment="Center" Margin="2,0,6,0" />
                <Separator />
                <StackPanel x:Name="TextProps" Orientation="Horizontal">
                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="4,0,4,0" />
                    <ComboBox x:Name="FontSizeBox" Width="58" IsEditable="True" KeyDown="FontSizeBox_KeyDown" SelectionChanged="FontSizeBox_SelectionChanged" />
                    <ComboBox x:Name="ColorBox" Width="84" Margin="6,0,0,0" SelectionChanged="ColorBox_SelectionChanged" />
                    <Separator />
                </StackPanel>
                <Button Style="{StaticResource ToolButton}" Click="CopyToAll_Click" ToolTip="Copy this item to the same spot on every page (e.g. initials)">⧉ All pages</Button>
                <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Delete (Del)" Foreground="#B91C1C">🗑 Delete</Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FieldInfo" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#555" />
                    <Button Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" Content="−" Width="24" Background="Transparent" BorderThickness="0" />
                    <ComboBox x:Name="ZoomBox" Width="86" IsEditable="True" KeyDown="ZoomBox_KeyDown" SelectionChanged="ZoomBox_SelectionChanged">
                        <ComboBoxItem>50%</ComboBoxItem>
                        <ComboBoxItem>75%</ComboBoxItem>
                        <ComboBoxItem>100%</ComboBoxItem>
                        <ComboBoxItem>125%</ComboBoxItem>
                        <ComboBoxItem>150%</ComboBoxItem>
                        <ComboBoxItem>200%</ComboBoxItem>
                        <ComboBoxItem>300%</ComboBoxItem>
                        <ComboBoxItem>Fit width</ComboBoxItem>
                    </ComboBox>
                    <Button Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl++)" Content="+" Width="24" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" />
                    <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="PageBox" Width="40" HorizontalContentAlignment="Center" KeyDown="PageBox_KeyDown" />
                    <TextBlock x:Name="PageCountText" Text="/ 0" VerticalAlignment="Center" Margin="4,0,4,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#E3E6EA" ScrollChanged="Scroller_ScrollChanged" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                          Focusable="True" FocusVisualStyle="{x:Null}">
                <StackPanel x:Name="PagesPanel" Margin="24" />
            </ScrollViewer>

            <Border x:Name="EmptyState" Background="#E3E6EA">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📄" FontSize="56" HorizontalAlignment="Center" Foreground="#8A93A0" />
                    <TextBlock Text="Open a PDF to fill in forms, add text and sign" FontSize="20" Margin="0,12,0,6"
                               HorizontalAlignment="Center" Foreground="#2B2F36" />
                    <TextBlock Text="or drag and drop a PDF file anywhere in this window" HorizontalAlignment="Center" Foreground="#6B7280" />
                    <Button Content="Open PDF…" Click="Open_Click" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Padding="22,8" FontSize="14" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
